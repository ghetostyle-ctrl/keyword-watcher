# NAVER 검색광고 관리 화면 > 도구 > API 사용 관리
# DataLab의 상대 지수가 아닌 PC + 모바일 월간 검색량을 수집합니다.
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# 공개 네트워크 바인딩은 허용하지 않습니다.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/trendwatch.sqlite

# 서버가 켜져 있을 때만 동작합니다. 한국 시간(KST) 기준입니다.
SCHEDULER_ENABLED=false
COLLECTION_HOUR=9
